# ============================================
# 星媛 Agent 配置文件
# 复制此文件为 .env 并填入实际值
# ============================================

# --- 智谱 AI ---
ZHIPUAI_API_KEY=your-zhipuai-api-key-here
# 模型：GLM-5.2-Flash = glm-4-flash (智谱最新快速模型)
ZHIPUAI_MODEL=glm-4-flash
ZHIPUAI_MAX_TOKENS=4096
ZHIPUAI_TEMPERATURE=0.7

# --- 服务认证 ---
# 留空则不启用 API Key 鉴权
SERVICE_API_KEY=
# JWT 签名密钥（生产环境必须在 Render 配置固定值，否则每次部署 token 全部失效；
# 留空则本地首次启动自动生成到 data/.jwt_secret）
JWT_SECRET=

# --- 服务配置 ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- CORS ---
# 允许的来源，逗号分隔。* 表示允许所有
CORS_ORIGINS=*

# --- 限流 ---
# 每分钟每IP最大请求数，0 表示不限制
RATE_LIMIT_PER_MINUTE=60

# --- 存储 ---
# Neon PostgreSQL 连接串（生产必填，asyncpg 使用）
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- 日志 ---
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
